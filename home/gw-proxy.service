[Unit]
Description=HTTPS front for the home gateway (chat, tts, stt only)
After=network-online.target

[Service]
Environment=PORT=18443
Environment=CERT=%h/.acme.sh/YOUR_DOMAIN_ecc/fullchain.cer
Environment=KEY=%h/.acme.sh/YOUR_DOMAIN_ecc/YOUR_DOMAIN.key
ExecStart=/usr/bin/env node %h/gw-proxy/server.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

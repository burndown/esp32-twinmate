# SSH tunnel from the gateway's machine to a relay server with a public IP ("relay"), as a systemd --user service.
#  -R: the relay's loopback port 18787 reaches the gateway here (the bot's callback comes in that way)
#  -L: this machine's loopback port 18790 reaches the relay's 18790 (the Webhook goes out that way)
# Replace YOUR_LAN_IP with the gateway's address and "relay" with your ssh host alias (key login, no prompt).
[Unit]
Description=SSH tunnel to the relay: the bot's callback comes in (-R), the Webhook goes out (-L)
After=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R 127.0.0.1:18787:YOUR_LAN_IP:8787 -L 127.0.0.1:18790:127.0.0.1:18790 relay
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

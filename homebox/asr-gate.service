# Replace YOUR_USER and YOUR_LAN_IP (this machine's LAN address), then: sudo cp to /etc/systemd/system/ && sudo systemctl enable --now <name>
[Unit]
Description=Token gate in front of the home speech recognition (for the cloud gateway via a tunnel)
After=network-online.target esp32-stt.service

[Service]
User=YOUR_USER
Environment=ASR_GATE_HOME=/home/YOUR_USER/asr-gate
ExecStart=/usr/bin/python3 /home/YOUR_USER/asr-gate/asr_gate.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target

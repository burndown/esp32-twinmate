+/* ---- Turn: local speech recognition ---- */
+
+/*
+ * Local addition: with CONFIG_MUSE_STT_URL set, the push-to-talk recording is
+ * kept here, POSTed to a speech-to-text server on the LAN when the button is
+ * released, and the text it returns goes to Muse as a typed message through
+ * post_chat(), so the reply comes back to the voice task like any other turn.
+ */
+static void post_chat(const char *text);
+
+enum stt_state_t : uint8_t { S_IDLE, S_BUSY, S_READY, S_FAILED };
+
+#define STT_TIMEOUT_MS 12000
+#define STT_PRIMARY_TIMEOUT_MS 5000   /* when a fallback server exists */
+
+EXT_RAM_BSS_ATTR static struct {
+    volatile stt_state_t state;
+    uint32_t gen;            /* the turn it belongs to */
+    uint8_t *pcm;            /* NOTE_MAX_BYTES of 16 kHz PCM16 */
+    size_t bytes;
+    char text[1024];
+} s_stt;
+
+/* One recognition request to url. Fills s_stt.text and returns true when the server answered {"text": ...}. */
+static bool stt_post(const char *url, int timeout_ms)
+{
+    bool ok = false;
+    esp_http_client_config_t cfg = {};
+    cfg.url = url;
+    cfg.crt_bundle_attach = esp_crt_bundle_attach;   /* an https gateway needs it; harmless for plain http */
+    cfg.method = HTTP_METHOD_POST;
+    cfg.timeout_ms = timeout_ms;
+    esp_http_client_handle_t h = esp_http_client_init(&cfg);
+    s_stt.text[0] = '\0';

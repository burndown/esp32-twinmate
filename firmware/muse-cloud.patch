+
+/* Scrolls the text a line at a time: with the speech if there is any, else at reading pace. */
+static void note_tick(float now)
+{
+    if (!s_note_shown || s_note_manual) {
+        return;
+    }
+    lv_obj_update_layout(s_note_box);
+    int32_t box_h = lv_obj_get_height(s_note_box);
+    int32_t lbl_h = lv_obj_get_height(s_note_lbl);
+    int32_t max = lbl_h - box_h;
+    if (max <= 0) {
+        return;
+    }
+    int32_t text_h = lbl_h - box_h / 2;   /* the label has box_h / 2 of padding below */
+    float prog = s_note_prog;
+    float want = prog >= 0 ? prog * text_h - box_h / 3 : (now - s_note_t0 - NOTE_START_S) * NOTE_PX_PER_S;
+    want = want < 0 ? 0 : want > max ? max : want;
+    s_note_y += (want - s_note_y) * 0.2f;
+    int32_t y = (int32_t)(s_note_y + 0.5f);
+    if (y != lv_obj_get_scroll_y(s_note_box)) {
+        lv_obj_scroll_to_y(s_note_box, y, LV_ANIM_OFF);
+    }
+}

+/* The Wi-Fi network the gadget is joined to, "" when it is not joined. */
+static void current_ssid(char *out, size_t cap)
+{
+    out[0] = '\0';
+    wifi_ap_record_t ap;
+    if (esp_wifi_sta_get_ap_info(&ap) == ESP_OK) {
+        strlcpy(out, (const char *)ap.ssid, cap);
+    }
+}
+
+/* On the home Wi-Fi (CONFIG_MUSE_HOME_SSID); true when no home network is configured. */
+static bool at_home(void)
+{
+    if (!CONFIG_MUSE_HOME_SSID[0]) {
+        return true;
+    }
+    char ssid[33];
+    current_ssid(ssid, sizeof(ssid));
+    return strcmp(ssid, CONFIG_MUSE_HOME_SSID) == 0;
+}
+
+/*
+ * 0: try the primary (home server) first; 1: go straight to the fallback (public address).
+ * With CONFIG_MUSE_HOME_SSID set, the joined network decides, whether or not Muse is paired or reachable: the home
+ * network means the LAN address, any other network means the public one. Without it, a quick connect probe decides.
+ */
+static int pick_first(int slot, const char *primary, const char *fallback)
+{
+    if (!fallback[0]) {
+        return 0;
+    }
+    if (CONFIG_MUSE_HOME_SSID[0]) {
+        char ssid[33];
+        current_ssid(ssid, sizeof(ssid));
+        bool home = strcmp(ssid, CONFIG_MUSE_HOME_SSID) == 0;
+        ESP_LOGI(TAG, "server %d: network \"%s\" is %s", slot, ssid, home ? "home: LAN address" : "not home: public address");
+        return home ? 0 : 1;
+    }
+    int64_t now = now_us();
+    if (now < s_primary_down_until[slot]) {
+        return 1;
+    }
+    if (host_reachable(primary, PRIMARY_PROBE_MS)) {
+        return 0;
+    }
+    s_primary_down_until[slot] = now + PRIMARY_DOWN_US;
+    ESP_LOGI(TAG, "primary server %d is not answering; using the fallback for a while", slot);
+    return 1;
+}

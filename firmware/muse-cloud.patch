+/*
+ * Local addition: with CONFIG_MUSE_BRAIN_URL set, the recognised text is
+ * POSTed to a text brain on the LAN and its reply streams back as plain text.
+ * A task reads the stream into a buffer; brain_poll(), on the network task,
+ * turns it into the same message pieces a Muse reply is made of, so captions,
+ * speech and the end of the turn work unchanged. If the brain can't be
+ * reached, the text goes to Muse instead.
+ */
+static void post_chat(const char *text);
+
+/*
+ * Local addition: a home server on the LAN first, a public address as the backup. Away from home the LAN address
+ * does not answer; a quick TCP connect finds that out in 1.5 s instead of a long request timeout, and the result
+ * is remembered for a while so each turn does not pay it again. A request that fails on the primary anyway is
+ * tried once on the fallback (see the three callers).
+ */
+enum { SLOT_STT, SLOT_BRAIN, SLOT_TTS, SLOT_COUNT };
+#define PRIMARY_PROBE_MS 1500
+#define PRIMARY_DOWN_US (90 * 1000000LL)
+static int64_t s_primary_down_until[SLOT_COUNT];
+
+static bool host_reachable(const char *url, int timeout_ms)
+{
+    const char *p = strstr(url, "://");
+    p = p ? p + 3 : url;
+    int port = !strncmp(url, "https", 5) ? 443 : 80;
+    char host[64];
+    size_t n = 0;
+    while (p[n] && p[n] != ':' && p[n] != '/' && p[n] != '?' && n < sizeof(host) - 1) {
+        host[n] = p[n];
+        n++;
+    }
+    host[n] = '\0';
+    if (p[n] == ':') {
+        port = atoi(p + n + 1);
+    }
+    char ps[8];
+    snprintf(ps, sizeof(ps), "%d", port);
+    struct addrinfo hints = {};
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    struct addrinfo *res = nullptr;
+    if (getaddrinfo(host, ps, &hints, &res) != 0 || !res) {
+        return false;
+    }
+    bool ok = false;
+    int fd = socket(res->ai_family, res->ai_socktype, 0);
+    if (fd >= 0) {
+        fcntl(fd, F_SETFL, fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+        int r = connect(fd, res->ai_addr, res->ai_addrlen);
+        if (r == 0) {
+            ok = true;
+        } else if (errno == EINPROGRESS) {
+            fd_set w;
+            FD_ZERO(&w);
+            FD_SET(fd, &w);
+            struct timeval tv = { timeout_ms / 1000, (timeout_ms % 1000) * 1000 };
+            if (select(fd + 1, nullptr, &w, nullptr, &tv) > 0) {
+                int err = 0;
+                socklen_t len = sizeof(err);
+                getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &len);
+                ok = err == 0;
+            }
+        }
+        close(fd);
+    }
+    freeaddrinfo(res);
+    return ok;
+}

+    const msg_t &m = s_turn.msgs[0];
+    size_t len = strnlen(s_turn.texts, TEXT_MAX);
+    if (m.tts < TTS_ACTIVE || !len || played < m.pcm_start) {
+        return 0.0f;
+    }
+    uint32_t frames = m.pcm_frames ? m.pcm_frames : (uint32_t)(len * MIC_RATE / SPEECH_CHARS_PER_S);

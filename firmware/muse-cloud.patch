+enum brain_state_t : uint8_t { B_IDLE, B_RUN, B_DONE, B_FAILED };
+
+EXT_RAM_BSS_ATTR static struct {
+    volatile brain_state_t state;
+    volatile uint32_t gen;   /* the turn the running task belongs to */
+    StreamBufferHandle_t buf;
+    char text[1024];         /* what was asked */
+    bool muse_down;          /* this request is the retry after Muse could not be reached */
+} s_brain;
+
+static void brain_task(void *arg)
+{
+    uint32_t gen = (uint32_t)(uintptr_t)arg;
+    bool got = false, ok = false;
+    cJSON *body = cJSON_CreateObject();
+    cJSON_AddStringToObject(body, "text", s_brain.text);
+    if (s_brain.muse_down) {
+        cJSON_AddTrueToObject(body, "muse_down");   /* the brain answers with its fallback provider */
+    }
+    if (!at_home()) {
+        cJSON_AddTrueToObject(body, "away");   /* away from the home Wi-Fi: the gateway hands the question to the Grok Bot */
+    }
+    char *json = cJSON_PrintUnformatted(body);
+    cJSON_Delete(body);
+    const char *urls[2] = { CONFIG_MUSE_BRAIN_URL, nullptr };
+    switch (pick_first(SLOT_BRAIN, CONFIG_MUSE_BRAIN_URL, CONFIG_MUSE_BRAIN_FALLBACK_URL)) {
+    case 1: urls[0] = CONFIG_MUSE_BRAIN_FALLBACK_URL; break;
+    default: if (CONFIG_MUSE_BRAIN_FALLBACK_URL[0]) urls[1] = CONFIG_MUSE_BRAIN_FALLBACK_URL;
+    }
+    for (int u = 0; u < 2 && urls[u] && !got && json; u++) {
+    esp_http_client_config_t cfg = {};
+    cfg.url = urls[u];
+    cfg.crt_bundle_attach = esp_crt_bundle_attach;   /* the gateway is https */
+    cfg.method = HTTP_METHOD_POST;
+    cfg.timeout_ms = 300000   /* a cloud bot may take minutes; the gateway speaks an acknowledgement first */;
+    esp_http_client_handle_t h = esp_http_client_init(&cfg);
+    if (h) {
+        esp_http_client_set_header(h, "Content-Type", "application/json");
+        esp_http_client_set_header(h, "X-Device", "muse-gadget");
+        if (esp_http_client_open(h, strlen(json)) == ESP_OK &&
+            esp_http_client_write(h, json, strlen(json)) == (int)strlen(json) &&
+            esp_http_client_fetch_headers(h) >= 0 && esp_http_client_get_status_code(h) == 200) {
+            ok = true;
+            char chunk[200];
+            int r;
+            while (gen == s_brain.gen && (r = esp_http_client_read(h, chunk, sizeof(chunk))) > 0) {
+                got = true;
+                if (xStreamBufferSend(s_brain.buf, chunk, r, pdMS_TO_TICKS(2000)) != (size_t)r) {
+                    break;   /* nobody is reading: the turn is gone */
+                }
+            }
+        }
+        esp_http_client_cleanup(h);
+    }
+    }
+    free(json);
+    ESP_LOGI(TAG, "brain: %s%s", ok ? "ok" : "failed", got ? "" : " (no text)");
+    if (gen == s_brain.gen) {
+        s_brain.state = got ? B_DONE : B_FAILED;
+    }
+    vTaskDelete(nullptr);
+}
+
+static bool brain_start(const char *text, bool muse_down = false)
+{
+    if (!CONFIG_MUSE_BRAIN_URL[0]) {
+        return false;
+    }
+    if (!s_brain.buf) {
+        s_brain.buf = xStreamBufferCreate(2048, 1);
+        if (!s_brain.buf) {
+            return false;
+        }
+    }
+    xStreamBufferReset(s_brain.buf);
+    if (text != s_brain.text) {
+        strlcpy(s_brain.text, text, sizeof(s_brain.text));
+    }
+    if (!muse_down && !at_home()) {
+        /* Away from home Muse is usually out of reach: the brain answers at once, without Muse being asked first
+         * (and without a long wait for a connection that will not come). */
+        muse_down = true;
+        ESP_LOGI(TAG, "away from home: the brain answers, Muse is not asked");
+    }
+    s_brain.muse_down = muse_down;
+    s_brain.gen = s_turn.gen;
+    s_brain.state = B_RUN;
+    if (xTaskCreate(brain_task, "brain", 6144, (void *)(uintptr_t)s_turn.gen, 4, nullptr) != pdPASS) {
+        s_brain.state = B_IDLE;
+        return false;
+    }
+    return true;
+}
+
+static void append_text(msg_t &m, const char *text);
+static void show_reply_start(const msg_t &m);
+static void message_done(int i, const char *final_text);
+
+/* Moves the brain's reply into the turn; falls back to Muse if the brain gave nothing. */
+static void brain_poll(void)
+{
+    if (!s_turn.brain || s_turn.phase != P_WAIT_REPLY || s_brain.gen != s_turn.gen) {
+        if (!s_turn.brain && (s_brain.state == B_DONE || s_brain.state == B_FAILED)) {
+            s_brain.state = B_IDLE;
+        }
+        return;
+    }
+    char tmp[200];
+    size_t n;
+    while ((n = xStreamBufferReceive(s_brain.buf, tmp, sizeof(tmp) - 1, 0)) > 0) {
+        tmp[n] = '\0';
+        if (!s_turn.nmsgs) {
+            msg_t &m0 = s_turn.msgs[0];
+            m0 = msg_t{};
+            strlcpy(m0.id, "local-brain", sizeof(m0.id));
+            s_turn.nmsgs = 1;
+        }
+        msg_t &m = s_turn.msgs[0];
+        s_turn.last_event_us = s_turn.last_content_us = now_us();
+        mark(M_TEXT);
+        append_text(m, tmp);
+        show_reply_start(m);   /* ignored once the speech starts */
+    }
+    if (s_brain.state != B_DONE && s_brain.state != B_FAILED) {
+        return;
+    }
+    if (xStreamBufferBytesAvailable(s_brain.buf)) {
+        return;   /* more to move first */
+    }
+    brain_state_t st = s_brain.state;
+    s_brain.state = B_IDLE;
+    if (s_turn.nmsgs) {
+        message_done(0, nullptr);
+        return;
+    }
+    (void)st;
+    if (s_brain.muse_down) {
+        turn_fail("CAN'T REACH MY BRAIN OR MUSE");   /* the retry failed too: nothing left to try */
+        return;
+    }
+    /* The brain stepped aside or didn't answer: Muse gets the same text. */
+    ESP_LOGW(TAG, "brain gave no reply, asking Muse instead");
+    s_turn.brain = false;
+    s_turn.chat_posted = false;
+    if (ensure_connected()) {
+        post_chat(s_brain.text);
+        return;
+    }
+    /* Muse can't be reached either (403, timeout): ask the brain again, as its fallback provider. */
+    ESP_LOGW(TAG, "Muse unreachable, asking the brain's fallback provider");
+    s_turn.brain = true;
+    s_turn.chat_posted = true;
+    s_turn.nmsgs = 0;
+    s_turn.chat_us = s_turn.last_event_us = now_us();
+    if (!brain_start(s_brain.text, true)) {
+        turn_fail("CAN'T REACH MY BRAIN OR MUSE");
+    }
+}
+
+/*
+ * Muse took the text but nothing came back within MUSE_GIVEUP_US: give up on it
+ * and ask the brain's fallback provider, once. Returns true if that was done.
+ */
+#define MUSE_GIVEUP_US ((int64_t)CONFIG_MUSE_BRAIN_GIVEUP_SECONDS * 1000000LL)   /* see Kconfig; REPLY_TIMEOUT_US still applies when there is no brain */
+
+static bool brain_retry_after_silence(void)
+{
+    if (!s_turn.local_stt || s_turn.brain || s_turn.nmsgs || !CONFIG_MUSE_BRAIN_URL[0] || s_brain.muse_down ||
+        now_us() - s_turn.chat_us < MUSE_GIVEUP_US) {
+        return false;
+    }
+    ESP_LOGW(TAG, "no answer from Muse in %d s, asking the brain's fallback provider", (int)(MUSE_GIVEUP_US / 1000000));
+    send_reset(s_turn.chat_id);   /* stop waiting on Muse's chat request */
+    s_turn.chat_id = 0;
+    s_turn.brain = true;          /* from here on Muse's events are ignored (see on_event) */
+    s_turn.chat_us = s_turn.last_event_us = now_us();
+    if (!brain_start(s_brain.text, true)) {
+        turn_fail("CAN'T REACH MY BRAIN OR MUSE");
+    }
+    return true;
+}
